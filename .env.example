# ---- Server ----
# Port the Express API listens on (5000 is taken by AirPlay Receiver on macOS)
PORT=5050
# node environment: development | production
NODE_ENV=development

# ---- Database ----
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/yugam-job-portal

# ---- Auth ----
# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (zeit/ms format)
JWT_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_ROUNDS=10

# ---- CORS ----
# Comma-separated allowlist of browser origins permitted to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- File uploads ----
# Where CVs and screening videos are kept:
#   local   this machine's disk (fine for development)
#   gridfs  inside MongoDB — use on Render/Railway/Heroku, whose disk is wiped
#           on every deploy. Move existing local files with: npm run migrate:uploads
STORAGE_DRIVER=local
# Directory (relative to backend/) where uploaded CVs are written
UPLOAD_DIR=uploads
# Max CV size in bytes (5 MB)
MAX_UPLOAD_BYTES=5242880

# ---- CV parsing ----
# Provider for turning CV text into structured fields:
#   ollama     a model running on this machine — free, no API key, no per-CV cost
#   anthropic  the hosted Claude API — needs LLM_API_KEY, billed per token
#   none       skip the LLM entirely; the regex parser handles every CV
# Leave blank to auto-detect: an API key selects anthropic, otherwise ollama.
LLM_PROVIDER=ollama

# --- Ollama (free, local) ---
# One-time setup:
#   brew install ollama && brew services start ollama
#   ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b

# --- Anthropic (paid, hosted) — only needed when LLM_PROVIDER=anthropic ---
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages

# Hard timeout (ms) for the whole parse step so uploads never hang.
# A local 3B model needs more headroom than a hosted API.
CV_PARSE_TIMEOUT_MS=30000

# ---- Email (nodemailer) ----
# In development, leave SMTP_HOST blank to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yugam International School <no-reply@yugam.edu.in>"

# ---- Seed admin ----
SEED_ADMIN_NAME=Yugam HR
SEED_ADMIN_EMAIL=hr@yugam.edu.in
SEED_ADMIN_PASSWORD=Admin@123

# ── Module 2: video screening ──────────────────────────────────────────
# Required. Signs the short-lived tokens on GET /media/:token — keep this
# distinct from JWT_SECRET so rotating login sessions does not break
# in-flight video links.
MEDIA_TOKEN_SECRET=
# (STORAGE_DRIVER is set once, above — it covers videos too.)
LOCAL_STORAGE_PATH=uploads
SIGNED_URL_TTL_SECONDS=900
SCREENING_EXPIRY_DAYS=7
RETENTION_MONTHS=12
MAX_UPLOAD_MB=60

# ffmpeg transcode. Off by default — turn on only if a reviewer reports a
# clip that will not play, and note ffmpeg must be installed.
ENABLE_TRANSCODE=false
FFMPEG_PATH=ffmpeg

# ── Optional: Cloudflare R2 ────────────────────────────────────────────
# Videos only (CVs stay local) — prefer gridfs unless storage size matters.
# Only when STORAGE_DRIVER=r2. Also requires:
#   npm i @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ── Optional: Google Meet for round two ────────────────────────────────
# Without these, scheduling works exactly as before and simply does not
# auto-generate a meeting link.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_REFRESH_TOKEN=
